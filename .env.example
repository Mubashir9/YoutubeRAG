EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
INDEX_DIR=data/index
TOP_K=5
# Optional: retrieval-only mode works without this.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Generation provider: groq or openai. Without the selected key, retrieval-only mode is used.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

